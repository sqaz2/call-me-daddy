{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "call-me-daddy",
  "compatibility_date": "2026-08-16",
  "main": "worker/index.mjs",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "callmedaddy.musicsubject.com",
      "custom_domain": true
    },
    { "pattern": "hiphop.bid", "custom_domain": true },
    { "pattern": "dubstep.bid", "custom_domain": true },
    { "pattern": "https.fyi", "custom_domain": true }
  ]
}
