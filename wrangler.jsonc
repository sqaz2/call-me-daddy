{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "call-me-daddy",
  "compatibility_date": "2026-08-16",
  "main": "worker/index.mjs",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/28475.jpeg",
      "/Twas_the_Tism_full_glitch_tweakout_final.mp3",
      "/media/*.aac",
      "/media/*.flac",
      "/media/*.m4a",
      "/media/*.mp3",
      "/media/*.mp4",
      "/media/*.ogg",
      "/media/*.wav",
      "/media/*.webm"
    ]
  },
  "routes": [
    {
      "pattern": "callmedaddy.musicsubject.com",
      "custom_domain": true
    }
  ]
}
