{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "musicsubject-song-links",
  "compatibility_date": "2026-09-11",
  "main": "worker/short-links.mjs",
  "routes": [
    { "pattern": "hiphop.bid", "custom_domain": true },
    { "pattern": "dubstep.bid", "custom_domain": true },
    { "pattern": "suno.fyi", "custom_domain": true }
  ]
}
